# Copia este archivo a ".env" y rellena tus valores

# Clave secreta de Stripe (sk_test_... o sk_live_...).
# Si la dejas vacia, la app corre en MODO DEMO (pagos simulados, sin dinero real).
# Consiguela gratis en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Secreto del webhook de Stripe (whsec_...), opcional pero recomendado en produccion.
STRIPE_WEBHOOK_SECRET=

# URL publica donde corre tu app.
BASE_URL=http://localhost:3000

PORT=3000
